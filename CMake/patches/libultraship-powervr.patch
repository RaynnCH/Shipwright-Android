+// PowerVR GPUs mis-render the mod()-based colour wrap emulation, so only they get the clamp() fallback.
+static bool IsPowerVRRenderer() {
+    static const bool sIsPowerVR = [] {
+        const char* renderer = reinterpret_cast<const char*>(glGetString(GL_RENDERER));
+        return renderer != nullptr && strstr(renderer, "PowerVR") != nullptr;
+    }();
+    return sIsPowerVR;
+}
